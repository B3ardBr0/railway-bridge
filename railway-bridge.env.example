# What the container reads. deploy.sh builds this from ~/.config/harbourmaster.env;
# to run by hand, copy it to railway-bridge.env and fill it in.
RAILWAY_TOKEN=a-railway-project-token
RAILWAY_PROJECT_ID=00000000-0000-0000-0000-000000000000
RAILWAY_ENVIRONMENT_ID=00000000-0000-0000-0000-000000000000
RAILWAY_SERVICE_ID=00000000-0000-0000-0000-000000000000
SERVICE_LABEL=web
POLL_SECONDS=300
BRIDGE_PORT=8098
